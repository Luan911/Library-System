        private void LoadTitles(string? searchTerm = null)
        {
            try
            {
                string query = searchTerm == null
                    ? "SELECT TitleID, Title, Author, ISBN, Genre FROM BookTitle ORDER BY TitleID"
                    : @"SELECT TitleID, Title, Author, ISBN, Genre FROM BookTitle
                        WHERE Title LIKE @Search OR Author LIKE @Search OR ISBN LIKE @Search
                        ORDER BY TitleID";

                var parameters = searchTerm == null
                    ? Array.Empty<SqlParameter>()
                    : new[] { new SqlParameter("@Search", $"%{searchTerm}%") };

                dgvTitles.DataSource = DatabaseHelper.ExecuteQuery(query, parameters);
                dgvTitles.Columns["TitleID"]!.HeaderText = "Title ID";
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading titles: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void LoadCopies()
        {
            try
            {
                const string query = @"SELECT bc.CopyID, bc.TitleID, bt.Title, bc.Status
                                       FROM BookCopy bc
                                       INNER JOIN BookTitle bt ON bc.TitleID = bt.TitleID
                                       ORDER BY bc.CopyID";
                dgvCopies.DataSource = DatabaseHelper.ExecuteQuery(query);
                dgvCopies.Columns["CopyID"]!.HeaderText = "Copy ID";
                dgvCopies.Columns["TitleID"]!.HeaderText = "Title ID";
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading copies: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void LoadTitleCombo()
        {
            try
            {
                var table = DatabaseHelper.ExecuteQuery(
                    "SELECT TitleID, Title FROM BookTitle ORDER BY Title");
                cboTitle.DataSource = table;
                cboTitle.DisplayMember = "Title";
                cboTitle.ValueMember = "TitleID";
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading titles: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void dgvTitles_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;

            var row = dgvTitles.Rows[e.RowIndex];
            txtTitleID.Text = row.Cells["TitleID"].Value?.ToString();
            txtTitle.Text = row.Cells["Title"].Value?.ToString();
            txtAuthor.Text = row.Cells["Author"].Value?.ToString();
            txtISBN.Text = row.Cells["ISBN"].Value?.ToString();
            cboGenre.Text = row.Cells["Genre"].Value?.ToString() ?? "";
        }

        private void dgvCopies_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;

            var row = dgvCopies.Rows[e.RowIndex];
            txtCopyID.Text = row.Cells["CopyID"].Value?.ToString();
            if (row.Cells["TitleID"].Value != null)
                cboTitle.SelectedValue = row.Cells["TitleID"].Value;
            cboCopyStatus.Text = row.Cells["Status"].Value?.ToString() ?? "Available";
        }

        private void btnAddTitle_Click(object sender, EventArgs e)
        {
            if (!ValidateTitleInput()) return;

            try
            {
                const string query = @"INSERT INTO BookTitle (Title, Author, ISBN, Genre)
                                       VALUES (@Title, @Author, @ISBN, @Genre)";
                DatabaseHelper.ExecuteNonQuery(query,
                    new SqlParameter("@Title", txtTitle.Text.Trim()),
                    new SqlParameter("@Author", txtAuthor.Text.Trim()),
                    new SqlParameter("@ISBN", txtISBN.Text.Trim()),
                    new SqlParameter("@Genre", string.IsNullOrWhiteSpace(cboGenre.Text) ? DBNull.Value : cboGenre.Text.Trim()));

                MessageBox.Show("Book title added successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearTitleFields();
                LoadTitles();
                LoadTitleCombo();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error adding title: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnUpdateTitle_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtTitleID.Text))
            {
                MessageBox.Show("Select a title to update.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!ValidateTitleInput()) return;

            try
            {
                const string query = @"UPDATE BookTitle SET Title = @Title, Author = @Author,
                                       ISBN = @ISBN, Genre = @Genre WHERE TitleID = @TitleID";
                DatabaseHelper.ExecuteNonQuery(query,
                    new SqlParameter("@Title", txtTitle.Text.Trim()),
                    new SqlParameter("@Author", txtAuthor.Text.Trim()),
                    new SqlParameter("@ISBN", txtISBN.Text.Trim()),
                    new SqlParameter("@Genre", string.IsNullOrWhiteSpace(cboGenre.Text) ? DBNull.Value : cboGenre.Text.Trim()),
                    new SqlParameter("@TitleID", int.Parse(txtTitleID.Text)));

                MessageBox.Show("Book title updated successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearTitleFields();
                LoadTitles();
                LoadTitleCombo();
                LoadCopies();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error updating title: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnDeleteTitle_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtTitleID.Text))
            {
                MessageBox.Show("Select a title to delete.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (MessageBox.Show("Delete this title and all its copies?", "Confirm Delete",
                    MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes)
                return;

            try
            {
                DatabaseHelper.ExecuteNonQuery("DELETE FROM BookTitle WHERE TitleID = @TitleID",
                    new SqlParameter("@TitleID", int.Parse(txtTitleID.Text)));

                MessageBox.Show("Book title deleted successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearTitleFields();
                LoadTitles();
                LoadTitleCombo();
                LoadCopies();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error deleting title: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

