        private void btnAddCopy_Click(object sender, EventArgs e)
        {
            if (cboTitle.SelectedValue == null)
            {
                MessageBox.Show("Select a book title for the copy.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (cboCopyStatus.Text == "On Loan")
            {
                MessageBox.Show("New copies cannot be added with 'On Loan' status.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                int titleId = Convert.ToInt32(cboTitle.SelectedValue);
                int count = (int)nudCopyCount.Value;
                string status = cboCopyStatus.Text;

                for (int i = 0; i < count; i++)
                {
                    DatabaseHelper.ExecuteNonQuery(
                        "INSERT INTO BookCopy (TitleID, Status) VALUES (@TitleID, @Status)",
                        new SqlParameter("@TitleID", titleId),
                        new SqlParameter("@Status", status));
                }

                MessageBox.Show($"{count} copy/copies added successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearCopyFields();
                LoadCopies();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error adding copy: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnUpdateCopy_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtCopyID.Text))
            {
                MessageBox.Show("Select a copy to update.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            int copyId = int.Parse(txtCopyID.Text);
            bool onLoan = DatabaseHelper.HasActiveLoan(copyId);

            if (onLoan && cboCopyStatus.Text != "On Loan")
            {
                MessageBox.Show(
                    "This copy has an active loan. Return the book before changing its status.",
                    "Update Not Allowed", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!onLoan && cboCopyStatus.Text == "On Loan")
            {
                MessageBox.Show(
                    "Status 'On Loan' is set automatically when a book is issued.",
                    "Validation", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                DatabaseHelper.ExecuteNonQuery(
                    "UPDATE BookCopy SET TitleID = @TitleID, Status = @Status WHERE CopyID = @CopyID",
                    new SqlParameter("@TitleID", Convert.ToInt32(cboTitle.SelectedValue)),
                    new SqlParameter("@Status", cboCopyStatus.Text),
                    new SqlParameter("@CopyID", copyId));

                MessageBox.Show("Book copy updated successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearCopyFields();
                LoadCopies();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error updating copy: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnDeleteCopy_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtCopyID.Text))
            {
                MessageBox.Show("Select a copy to delete.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (MessageBox.Show("Delete this book copy?", "Confirm Delete",
                    MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes)
                return;

            int copyId = int.Parse(txtCopyID.Text);
            if (DatabaseHelper.HasActiveLoan(copyId))
            {
                MessageBox.Show(
                    "This copy cannot be deleted because it is currently on loan.",
                    "Delete Not Allowed", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                DatabaseHelper.ExecuteNonQuery("DELETE FROM BookCopy WHERE CopyID = @CopyID",
                    new SqlParameter("@CopyID", copyId));

                MessageBox.Show("Book copy deleted successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearCopyFields();
                LoadCopies();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error deleting copy: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnClearTitle_Click(object sender, EventArgs e) => ClearTitleFields();
        private void btnClearCopy_Click(object sender, EventArgs e) => ClearCopyFields();

        private void ClearTitleFields()
        {
            txtTitleID.Clear();
            txtTitle.Clear();
            txtAuthor.Clear();
            txtISBN.Clear();
            cboGenre.SelectedIndex = -1;
            cboGenre.Text = "";
            txtBookSearch.Clear();
        }

        private void ClearCopyFields()
        {
            txtCopyID.Clear();
            cboCopyStatus.SelectedItem = "Available";
            nudCopyCount.Value = 1;
        }

        private bool ValidateTitleInput()
        {
            if (string.IsNullOrWhiteSpace(txtTitle.Text))
            {
                MessageBox.Show("Title is required.", "Validation", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            if (string.IsNullOrWhiteSpace(txtAuthor.Text))
            {
                MessageBox.Show("Author is required.", "Validation", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            if (string.IsNullOrWhiteSpace(txtISBN.Text))
            {
                MessageBox.Show("ISBN is required.", "Validation", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            return true;
        }
    }
}
