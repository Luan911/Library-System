        private void LoadMembers(string? searchTerm = null)
        {
            try
            {
                string query = searchTerm == null
                    ? "SELECT MemberID, FullName, Address, Phone, JoinDate FROM Member ORDER BY MemberID"
                    : @"SELECT MemberID, FullName, Address, Phone, JoinDate FROM Member
                        WHERE FullName LIKE @Search OR Phone LIKE @Search OR Address LIKE @Search
                           OR CAST(MemberID AS VARCHAR) LIKE @Search
                        ORDER BY MemberID";

                var parameters = searchTerm == null
                    ? Array.Empty<SqlParameter>()
                    : new[] { new SqlParameter("@Search", $"%{searchTerm}%") };

                dgvMembers.DataSource = DatabaseHelper.ExecuteQuery(query, parameters);
                dgvMembers.Columns["MemberID"]!.HeaderText = "Member ID";
                dgvMembers.Columns["FullName"]!.HeaderText = "Full Name";
                dgvMembers.Columns["JoinDate"]!.HeaderText = "Join Date";
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading members: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void dgvMembers_CellClick(object? sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;

            var row = dgvMembers.Rows[e.RowIndex];
            txtMemberID.Text = row.Cells["MemberID"].Value?.ToString();
            txtFullName.Text = row.Cells["FullName"].Value?.ToString();
            txtAddress.Text = row.Cells["Address"].Value?.ToString();
            txtPhone.Text = row.Cells["Phone"].Value?.ToString();

            if (DateTime.TryParse(row.Cells["JoinDate"].Value?.ToString(), out var joinDate))
                dtpJoinDate.Value = joinDate;
        }

        private void btnAdd_Click(object? sender, EventArgs e)
        {
            if (!ValidateInput()) return;

            try
            {
                const string query = @"INSERT INTO Member (FullName, Address, Phone, JoinDate)
                                       VALUES (@FullName, @Address, @Phone, @JoinDate)";
                DatabaseHelper.ExecuteNonQuery(query,
                    new SqlParameter("@FullName", txtFullName.Text.Trim()),
                    new SqlParameter("@Address", txtAddress.Text.Trim()),
                    new SqlParameter("@Phone", txtPhone.Text.Trim()),
                    new SqlParameter("@JoinDate", dtpJoinDate.Value.Date));

                MessageBox.Show("Member added successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearFields();
                LoadMembers();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error adding member: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnUpdate_Click(object? sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtMemberID.Text))
            {
                MessageBox.Show("Select a member to update.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!ValidateInput()) return;

            try
            {
                const string query = @"UPDATE Member SET FullName = @FullName, Address = @Address,
                                       Phone = @Phone, JoinDate = @JoinDate WHERE MemberID = @MemberID";
                int rows = DatabaseHelper.ExecuteNonQuery(query,
                    new SqlParameter("@FullName", txtFullName.Text.Trim()),
                    new SqlParameter("@Address", txtAddress.Text.Trim()),
                    new SqlParameter("@Phone", txtPhone.Text.Trim()),
                    new SqlParameter("@JoinDate", dtpJoinDate.Value.Date),
                    new SqlParameter("@MemberID", int.Parse(txtMemberID.Text)));

                if (rows > 0)
                {
                    MessageBox.Show("Member updated successfully.", "Success",
                        MessageBoxButtons.OK, MessageBoxIcon.Information);
                    ClearFields();
                    LoadMembers();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error updating member: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnDelete_Click(object? sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtMemberID.Text))
            {
                MessageBox.Show("Select a member to delete.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var confirm = MessageBox.Show("Are you sure you want to delete this member?",
                "Confirm Delete", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm != DialogResult.Yes) return;

            int memberId = int.Parse(txtMemberID.Text);
            if (DatabaseHelper.MemberHasLoans(memberId))
            {
                MessageBox.Show(
                    "This member cannot be deleted because they have loan records.\n" +
                    "Members with any loan history are protected by referential integrity.",
                    "Delete Not Allowed", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                const string query = "DELETE FROM Member WHERE MemberID = @MemberID";
                DatabaseHelper.ExecuteNonQuery(query,
                    new SqlParameter("@MemberID", memberId));

                MessageBox.Show("Member deleted successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                ClearFields();
                LoadMembers();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error deleting member: {ex.Message}",
                    "Database Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

