        private void ApplyLoanFilter(string filter)
        {
            _loanFilter = filter;
            grpHistory.Text = filter switch
            {
                "Active" => "Loan Records — Active",
                "Returned" => "Loan Records — Returned",
                "Overdue" => "Loan Records — Overdue",
                _ => "Loan Records — All"
            };
            LoadFilteredLoans();
        }

        private void LoadComboBoxes()
        {
            try
            {
                var members = DatabaseHelper.ExecuteQuery(
                    "SELECT MemberID, FullName FROM Member ORDER BY FullName");
                cboMember.DataSource = members;
                cboMember.DisplayMember = "FullName";
                cboMember.ValueMember = "MemberID";

                var staff = DatabaseHelper.ExecuteQuery(
                    "SELECT StaffID, FullName FROM Staff ORDER BY FullName");
                cboStaff.DataSource = staff;
                cboStaff.DisplayMember = "FullName";
                cboStaff.ValueMember = "StaffID";

                LoadAvailableCopies();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading data: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void LoadAvailableCopies()
        {
            const string query = @"SELECT bc.CopyID,
                                          bt.Title + ' (Copy #' + CAST(bc.CopyID AS VARCHAR) + ')' AS CopyDescription
                                   FROM BookCopy bc
                                   INNER JOIN BookTitle bt ON bc.TitleID = bt.TitleID
                                   WHERE bc.Status = 'Available'
                                   ORDER BY bt.Title, bc.CopyID";
            var copies = DatabaseHelper.ExecuteQuery(query);
            cboCopy.DataSource = copies;
            cboCopy.DisplayMember = "CopyDescription";
            cboCopy.ValueMember = "CopyID";
        }

        private void LoadCurrentLoans()
        {
            try
            {
                const string query = @"SELECT l.LoanID, m.FullName AS Member, bt.Title AS Book,
                                              bc.CopyID, s.FullName AS Staff,
                                              l.LoanDate, l.DueDate
                                       FROM Loan l
                                       INNER JOIN Member m ON l.MemberID = m.MemberID
                                       INNER JOIN BookCopy bc ON l.CopyID = bc.CopyID
                                       INNER JOIN BookTitle bt ON bc.TitleID = bt.TitleID
                                       INNER JOIN Staff s ON l.StaffID = s.StaffID
                                       WHERE l.ReturnDate IS NULL
                                       ORDER BY l.DueDate";
                dgvCurrentLoans.DataSource = DatabaseHelper.ExecuteQuery(query);
                ApplyLoanGridColumns(dgvCurrentLoans, includeReturnDate: false);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading current loans: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void LoadFilteredLoans()
        {
            try
            {
                string query = _loanFilter switch
                {
                    "Active" => @"SELECT l.LoanID, m.FullName AS Member, bt.Title AS Book,
                                         bc.CopyID, s.FullName AS Staff, l.LoanDate, l.DueDate, l.ReturnDate
                                  FROM Loan l
                                  INNER JOIN Member m ON l.MemberID = m.MemberID
                                  INNER JOIN BookCopy bc ON l.CopyID = bc.CopyID
                                  INNER JOIN BookTitle bt ON bc.TitleID = bt.TitleID
                                  INNER JOIN Staff s ON l.StaffID = s.StaffID
                                  WHERE l.ReturnDate IS NULL
                                  ORDER BY l.DueDate",
                    "Overdue" => @"SELECT l.LoanID, m.FullName AS Member, bt.Title AS Book,
                                          bc.CopyID, s.FullName AS Staff, l.LoanDate, l.DueDate, l.ReturnDate
                                   FROM Loan l
                                   INNER JOIN Member m ON l.MemberID = m.MemberID
                                   INNER JOIN BookCopy bc ON l.CopyID = bc.CopyID
                                   INNER JOIN BookTitle bt ON bc.TitleID = bt.TitleID
                                   INNER JOIN Staff s ON l.StaffID = s.StaffID
                                   WHERE l.ReturnDate IS NULL AND l.DueDate < CAST(GETDATE() AS DATE)
                                   ORDER BY l.DueDate",
                    "All" => @"SELECT l.LoanID, m.FullName AS Member, bt.Title AS Book,
                                      bc.CopyID, s.FullName AS Staff, l.LoanDate, l.DueDate, l.ReturnDate
                               FROM Loan l
                               INNER JOIN Member m ON l.MemberID = m.MemberID
                               INNER JOIN BookCopy bc ON l.CopyID = bc.CopyID
                               INNER JOIN BookTitle bt ON bc.TitleID = bt.TitleID
                               INNER JOIN Staff s ON l.StaffID = s.StaffID
                               ORDER BY l.LoanDate DESC",
                    _ => @"SELECT l.LoanID, m.FullName AS Member, bt.Title AS Book,
                                  bc.CopyID, s.FullName AS Staff, l.LoanDate, l.DueDate, l.ReturnDate
                           FROM Loan l
                           INNER JOIN Member m ON l.MemberID = m.MemberID
                           INNER JOIN BookCopy bc ON l.CopyID = bc.CopyID
                           INNER JOIN BookTitle bt ON bc.TitleID = bt.TitleID
                           INNER JOIN Staff s ON l.StaffID = s.StaffID
                           WHERE l.ReturnDate IS NOT NULL
                           ORDER BY l.ReturnDate DESC"
                };

                dgvHistoricalLoans.DataSource = DatabaseHelper.ExecuteQuery(query);
                ApplyLoanGridColumns(dgvHistoricalLoans, includeReturnDate: true);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading loans: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void LoadHistoricalLoans() => LoadFilteredLoans();

        private static void ApplyLoanGridColumns(DataGridView grid, bool includeReturnDate)
        {
            if (grid.Columns.Count == 0) return;

            SetColumn(grid, "LoanID", "Loan ID", 70);
            SetColumn(grid, "Member", "Member", 140);
            SetColumn(grid, "Book", "Book", 200);
            SetColumn(grid, "CopyID", "Copy ID", 70);
            SetColumn(grid, "Staff", "Staff", 120);
            SetColumn(grid, "LoanDate", "Loan Date", 90);
            SetColumn(grid, "DueDate", "Due Date", 90);
            if (includeReturnDate)
                SetColumn(grid, "ReturnDate", "Return Date", 95);
        }

        private static void SetColumn(DataGridView grid, string name, string header, int fillWeight)
        {
            if (!grid.Columns.Contains(name)) return;
            var col = grid.Columns[name];
            col.HeaderText = header;
            col.FillWeight = fillWeight;
            col.MinimumWidth = 60;
        }

        private void btnIssue_Click(object sender, EventArgs e)
        {
            if (cboMember.SelectedValue == null || cboCopy.SelectedValue == null || cboStaff.SelectedValue == null)
            {
                MessageBox.Show("Select a member, available book copy, and staff member.",
                    "Validation", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (dtpDueDate.Value.Date < dtpLoanDate.Value.Date)
            {
                MessageBox.Show("Due date cannot be before loan date.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                int copyId = Convert.ToInt32(cboCopy.SelectedValue);
                int memberId = Convert.ToInt32(cboMember.SelectedValue);
                int staffId = Convert.ToInt32(cboStaff.SelectedValue);
                var loanDate = dtpLoanDate.Value.Date;
                var dueDate = dtpDueDate.Value.Date;

                DatabaseHelper.ExecuteTransaction((conn, trans) =>
                {
                    var status = DatabaseHelper.ExecuteScalar(conn, trans,
                        "SELECT Status FROM BookCopy WHERE CopyID = @CopyID",
                        new SqlParameter("@CopyID", copyId))?.ToString();

                    if (status != "Available")
                        throw new InvalidOperationException("This book copy is not available for loan.");

                    DatabaseHelper.ExecuteNonQuery(conn, trans,
                        @"INSERT INTO Loan (MemberID, CopyID, StaffID, LoanDate, DueDate)
                          VALUES (@MemberID, @CopyID, @StaffID, @LoanDate, @DueDate)",
                        new SqlParameter("@MemberID", memberId),
                        new SqlParameter("@CopyID", copyId),
                        new SqlParameter("@StaffID", staffId),
                        new SqlParameter("@LoanDate", loanDate),
                        new SqlParameter("@DueDate", dueDate));

                    DatabaseHelper.ExecuteNonQuery(conn, trans,
                        "UPDATE BookCopy SET Status = 'On Loan' WHERE CopyID = @CopyID",
                        new SqlParameter("@CopyID", copyId));
                });

                MessageBox.Show("Book issued successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);

                LoadAvailableCopies();
                LoadCurrentLoans();
                LoadFilteredLoans();
            }
            catch (InvalidOperationException ex)
            {
                MessageBox.Show(ex.Message, "Validation", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error issuing book: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnReturn_Click(object sender, EventArgs e)
        {
            if (dgvCurrentLoans.CurrentRow == null)
            {
                MessageBox.Show("Select an active loan to return.", "Validation",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                int loanId = Convert.ToInt32(dgvCurrentLoans.CurrentRow.Cells["LoanID"].Value);
                int copyId = Convert.ToInt32(dgvCurrentLoans.CurrentRow.Cells["CopyID"].Value);

                DatabaseHelper.ExecuteTransaction((conn, trans) =>
                {
                    DatabaseHelper.ExecuteNonQuery(conn, trans,
                        "UPDATE Loan SET ReturnDate = @ReturnDate WHERE LoanID = @LoanID AND ReturnDate IS NULL",
                        new SqlParameter("@ReturnDate", DateTime.Today),
                        new SqlParameter("@LoanID", loanId));

                    DatabaseHelper.ExecuteNonQuery(conn, trans,
                        "UPDATE BookCopy SET Status = 'Available' WHERE CopyID = @CopyID",
                        new SqlParameter("@CopyID", copyId));
                });

                MessageBox.Show("Book returned successfully.", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);

                LoadAvailableCopies();
                LoadCurrentLoans();
                LoadFilteredLoans();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error returning book: {ex.Message}", "Database Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

